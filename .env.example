# ============================================================================
# Environment configuration
# ----------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# The site renders completely with NONE of these set — config/profile.php is
# the source of truth and the database is an optional override layer. Set the
# values below only for the features you actually want.
# ============================================================================


# --- Application ------------------------------------------------------------

# 'production' hides errors from visitors and logs them instead.
# Use 'local' while developing to see errors on screen.
APP_ENV=production

# Absolute public URL, no trailing slash. Used for canonical tags, Open Graph
# images, and the sitemap. Leave blank to derive it from the request, which is
# fine locally but should be set explicitly in production.
APP_URL=https://your-domain.com

# Case studies live at /projects/<slug>. That needs a rewrite rule: .htaccess
# covers Apache, router.php covers `php -S`, and DEPLOY.md has the Nginx block.
# On a host that cannot rewrite, set this to false to use project.php?slug=.
PRETTY_URLS=true


# --- Database (optional) ----------------------------------------------------
#
# Only needed for the /admin content panel and for storing contact messages.
# Set DB_ENABLED=false to skip connection attempts entirely — the public site
# is fully functional without a database.

DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=portfolio_db

# Seconds to wait for a connection before falling back to file content.
DB_TIMEOUT=3


# --- GitHub API (optional) --------------------------------------------------
#
# Without a token the API allows 60 requests per hour per IP, which a shared
# host can exhaust quickly. A token raises that to 5,000/hour.
#
# Create one at: https://github.com/settings/tokens?type=beta
# It needs NO scopes at all — public repository data is all that is read.
# The token stays server-side and is never sent to the browser.

GITHUB_TOKEN=

# How long a cached GitHub response stays fresh, in seconds (default 6 hours).
GITHUB_CACHE_TTL=21600


# --- Contact form email (optional) ------------------------------------------
#
# Leave MAIL_HOST blank to fall back to PHP's mail() function. On most shared
# hosting, SMTP is far more reliable and much less likely to be marked as spam.
#
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
#        (requires 2-Step Verification) and use that, never the account password.

MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Portfolio Website"

# Where contact form submissions are delivered.
# Defaults to the address in config/profile.php when left blank.
MAIL_TO=

# Web installer. Set a long random value to enable /setup.php, then DELETE
# this line once setup is finished. Leaving it set keeps the installer live.
SETUP_KEY=
