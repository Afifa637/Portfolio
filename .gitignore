# Dependencies
/vendor/

# Environment — never commit real credentials
/.env
/.env.*
!/.env.example

# Runtime cache (the bundled GitHub snapshot IS committed)
/storage/cache/*
!/storage/cache/.gitignore

# Database dumps
/database/backups/

# Original full-resolution images, kept locally as optimisation sources
/assets/images/original/

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log

# Static build output (generated by tools/build-static.php)
/dist/
